{
  "name": "crew-health-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D astronaut health twin: every body system is a data object whose live health status drives its color. NASA Space Apps 2026 prototype. Code written with AI assistance (Claude Code) - see README.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:model": "node tools/build-body-model.mjs assets-src/bodyparts3d assets-src/bodyparts3d/obj/isa_BP3D_4.0_obj_99 public/models/body.glb",
    "sources:smoke": "node tools/ingest/smoke.mjs data/snapshots",
    "refs:verify": "node tools/references/verify.mjs data/matrix reference_map.csv",
    "db:build": "node tools/db/build.mjs data/matrix tools/db/migrations data/crew-health.db",
    "ingest:space-weather": "node tools/ingest/space-weather.mjs data/snapshots",
    "ingest:mmash": "node tools/ingest/mmash.mjs data/raw/mmash/extract/DataPaper data/snapshots/mmash/derived.json",
    "validate:calibrate": "node tools/validate/calibrate-drift.mjs data/validation/drift-calibration.json",
    "validate:injection": "node tools/validate/inject-anomalies.mjs data/validation/drift-calibration.json data/validation/anomaly-injection.json",
    "validate:mmash": "node tools/validate/mmash.mjs data/snapshots/mmash/derived.json data/validation/drift-calibration.json data/validation/mmash-validation.json",
    "validate": "npm run validate:calibrate && npm run validate:injection && npm run validate:mmash",
    "api": "node server/index.mjs",
    "demo:offline": "node tools/demo-offline.mjs",
    "demo:check": "node tools/demo-offline.mjs --check"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "qrcode-generator": "^2.0.4",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
